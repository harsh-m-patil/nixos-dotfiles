#!/usr/bin/env bash
# Copy to 10-reload-desktop (no .sample) and chmod +x to run after every switch.
# Activation runs outside the Hyprland session, so locate its socket first.
sig="$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null | head -n1)"
[[ -n "$sig" ]] || exit 0
HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl reload >/dev/null
